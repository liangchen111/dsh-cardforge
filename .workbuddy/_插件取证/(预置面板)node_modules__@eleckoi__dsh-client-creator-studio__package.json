{
  "name": "@eleckoi/dsh-client-creator-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./client": {
      "types": "./src/client/types.ts",
      "default": "./src/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-workspace-controller",
        "@eleckoi/dsh-product-api"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "description": "管理创作工作室项目目录。",
  "engines": {
    "dsh": "0.2.0-rc.2"
  },
  "eleckoi": {
    "developerInterfaces": [
      {
        "id": "eleckoiCreatorStudio",
        "kind": "service",
        "title": "创作项目服务",
        "description": "读取、创建、删除创作项目并订阅项目列表变化。",
        "mode": "call",
        "scope": "client",
        "relation": "provides",
        "members": [
          "getSnapshot",
          "subscribe",
          "refresh",
          "create",
          "delete",
          "selectDirectory"
        ]
      }
    ]
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@eleckoi/dsh-product-api": "workspace:*"
  }
}
