{
  "说明": "sandbox 的差分语料：同一串步骤跑**两遍**（模式关 / 模式开），比每一步的返回值与文件现场。开与关的差别只在这几处：land 走改名还是直接覆盖（临时文件还在不在）、retire 变墓碑、shell 变空壳。另附 note / take_flag / enabled 三个开关函数。",
  "步骤": [
    { "做": "目录", "路径": "子目录" },
    { "做": "写", "路径": "甲/现有.txt", "内容": "原内容\n" },
    { "做": "写", "路径": "甲/待删.txt", "内容": "删我\n" },
    { "做": "写", "路径": "子目录/里.txt", "内容": "里\n" },
    { "做": "写", "路径": "甲/临时.txt", "内容": "新内容\n" },
    { "做": "写", "路径": "甲/样式.css", "内容": ".a { color: red }\n" },
    { "做": "写", "路径": "甲/脚本.js", "内容": "var a = 1\n" },
    { "做": "写", "路径": "甲/记录.json", "内容": "{\"a\": 1}\n" },

    { "做": "调", "调用": "land", "参数": ["@根@/甲/临时.txt", "@根@/甲/现有.txt"] },
    { "做": "读", "路径": "甲/现有.txt" },
    { "做": "在", "路径": "甲/临时.txt" },

    { "做": "调", "调用": "remove", "参数": ["@根@/甲/待删.txt"] },
    { "做": "在", "路径": "甲/待删.txt" },

    { "做": "调", "调用": "cleanup", "参数": ["@根@/甲/临时.txt"] },
    { "做": "在", "路径": "甲/临时.txt" },

    { "做": "调", "调用": "rmtree", "参数": ["@根@/子目录"] },
    { "做": "在", "路径": "子目录" },

    { "做": "调", "调用": "retire", "参数": ["@根@/甲/记录.json"] },
    { "做": "在", "路径": "甲/记录.json" },
    { "做": "读", "路径": "甲/记录.json" },

    { "做": "调", "调用": "shell", "参数": ["@根@/甲/样式.css", "夹具说明"] },
    { "做": "读", "路径": "甲/样式.css" },
    { "做": "调", "调用": "shell", "参数": ["@根@/甲/脚本.js", "夹具说明"] },
    { "做": "读", "路径": "甲/脚本.js" },
    { "做": "调", "调用": "shell", "参数": ["@根@/甲/记录.json", "夹具说明"] },
    { "做": "读", "路径": "甲/记录.json" },

    { "做": "调", "调用": "is_tombstone", "参数": [{ "_作废": true }] },
    { "做": "调", "调用": "is_tombstone", "参数": [{ "正常": true }] },
    { "做": "调", "调用": "is_tombstone", "参数": ["不是字典"] },
    { "做": "调", "调用": "note" }
  ],
  "开关": [
    { "做": "调", "调用": "take_flag", "参数": [["x", "--沙箱", "y"]] },
    { "做": "调", "调用": "take_flag", "参数": [["x", "--sandbox", "--别的", "y"]] },
    { "做": "调", "调用": "take_flag", "参数": [["a", "b"]] }
  ]
}
