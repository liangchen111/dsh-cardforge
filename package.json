{
  "name": "dsh-cardforge",
  "version": "0.29.0",
  "description": "ElecKoi 制卡工具（forge）：教 AI 做卡的命令行工具，外加一个让 ElecKoi 里的 AI 直接跑它的宿主插件。",
  "license": "MIT",
  "type": "module",
  "main": "插件/制卡工坊/index.js",
  "exports": {
    ".": "./插件/制卡工坊/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./插件/制卡工坊/locale/*.json"
  },
  "files": [
    "forge.py",
    "forge/",
    "forgejs/",
    "assets/",
    "samples/",
    "向导/",
    "插件/",
    "tests/",
    "门禁.py",
    "文档/使用说明.md",
    "文档/插件-DSH.md",
    "文档/插件-ElecKoi.md",
    "文档/装完怎么验.md",
    "cordis.patch.yml",
    "pyproject.toml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "dsh-plugin",
    "eleckoi",
    "sillytavern",
    "character-card",
    "roleplay"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
